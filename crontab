# YEARLY POINTS RESET: Reset all user points on January 1st at midnight UTC
0 0 1 1 * /app/reset-yearly-points.sh

# Sync driver standings twice weekly: Monday and Thursday at 9:00 AM UTC
# This covers both regular race weekends (Sunday) and sprint weekends (Saturday)
0 9 * * 1,4 /app/sync-driver-standings.sh

# Sync race results every Monday at 3:00 AM UTC
0 3 * * 1 /app/sync-race-results.sh

# SYNC QUALIFYING RESULTS: Run hourly on Fri+Sat (qualifying days)
# Picks up qualifying data ~2 hours after session ends
0 * * * 5,6 /app/sync-qualifying-results.sh

# COPY MISSING PREDICTIONS: Check every 2 minutes on race days (Sat sprint + Sun main, 12:00-18:00 UTC)
# Copies last prediction for users who forgot to submit
*/2 12-18 * * 0,6 /app/copy-missing-predictions.sh

# PROVISIONAL RESULTS: Check every 5 minutes on race days (Sat sprint + Sun main, 12:00-20:00 UTC)
# Sends provisional results email ~5 minutes after race ends, calculates points, marks status='provisional'
*/5 12-20 * * 0,6 /app/send-provisional-results.sh

# FINAL RESULTS: Process 24 hours after race (Sun for Sat sprints, Mon for Sun main races, 12:00-20:00 UTC)
# Recalculates points considering disqualifications/penalties; only acts on status='provisional' races
0 12-20 * * 0,1 /app/process-final-results.sh

# Log rotation to prevent log file from growing too large
0 0 * * 0 echo "" > /var/log/cron.log
